{
  "openapi": "3.0.3",
  "info": {
    "title": "TicketYa - API de Usuarios",
    "version": "1.0.0",
    "description": "Contrato de la entrega 1, sin JWT. Usuarios, roles y artistas favoritos. Los ejemplos de IDs son ilustrativos. Los errores de Spring pueden omitir detail; solo status es obligatorio en Error."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "API Gateway"
    },
    {
      "url": "http://localhost:8004",
      "description": "Microservicio directo"
    }
  ],
  "tags": [
    {
      "name": "Usuarios"
    },
    {
      "name": "Roles"
    },
    {
      "name": "Favoritos"
    }
  ],
  "security": [],
  "paths": {
    "/usuarios": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "get_usuarios",
        "summary": "Listar usuarios",
        "description": "Devuelve todos los perfiles sin paginación ni autenticación.",
        "responses": {
          "200": {
            "description": "Consulta o actualización exitosa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioResponse"
                  }
                },
                "example": [
                  {
                    "id": 42,
                    "nombre": "Ana Pérez",
                    "email": "ana.prueba@example.com",
                    "dni": "PRUEBA-001",
                    "ciudad": "Tandil",
                    "idRol": 7
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "post_usuarios",
        "summary": "Crear usuario",
        "description": "Nombre, email, DNI, ciudad e idRol son obligatorios. El rol debe existir. Email y DNI tienen unicidad en la base. No acepta credenciales JWT.",
        "responses": {
          "201": {
            "description": "Recurso creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                },
                "example": {
                  "id": 42,
                  "nombre": "Ana Pérez",
                  "email": "ana.prueba@example.com",
                  "dni": "PRUEBA-001",
                  "ciudad": "Tandil",
                  "idRol": 7
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta relativa del recurso creado.",
                "schema": {
                  "type": "string"
                },
                "example": "/usuarios/42"
              }
            }
          },
          "400": {
            "description": "JSON, tipo o datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "timestamp": "2026-11-09T12:00:00Z",
                  "status": 400,
                  "error": "Bad Request",
                  "path": "/usuarios"
                }
              }
            }
          },
          "404": {
            "description": "Usuario o rol inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "timestamp": "2026-11-09T12:00:00Z",
                  "status": 404,
                  "error": "Not Found",
                  "path": "/usuarios"
                }
              }
            }
          },
          "409": {
            "description": "Datos duplicados o recurso con relaciones que impiden la operación.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "La operacion viola una restriccion: datos duplicados o relaciones existentes",
                  "instance": "/usuarios"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Conflict",
                  "status": 409,
                  "detail": "La operacion viola una restriccion: datos duplicados o relaciones existentes",
                  "instance": "/usuarios"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioRequest"
              },
              "example": {
                "nombre": "Ana Pérez",
                "email": "ana.prueba@example.com",
                "dni": "PRUEBA-001",
                "ciudad": "Tandil",
                "idRol": 7
              }
            }
          }
        }
      }
    },

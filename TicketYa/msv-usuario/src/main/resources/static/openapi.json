    "/usuarios/{id}/artistas-favoritos": {
      "get": {
        "tags": [
          "Favoritos"
        ],
        "operationId": "get_usuarios_id_artistas-favoritos",
        "summary": "Listar artistas favoritos",
        "description": "Devuelve idArtista, nombre y genero consultando Eventos. Sin favoritos devuelve []. No se garantiza el orden. Responde 502 si un artista ya no existe o devuelve datos incompletos y 503 si Eventos no esta disponible.",
        "responses": {
          "200": {
            "description": "Consulta o actualización exitosa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "nombre": {
                        "type": "string"
                      },
                      "idArtista": {
                        "format": "int64",
                        "type": "integer"
                      },
                      "genero": {
                        "nullable": true,
                        "type": "string"
                      }
                    },
                    "required": [
                      "idArtista",
                      "nombre",
                      "genero"
                    ],
                    "type": "object"
                  }
                },
                "example": [
                  {
                    "nombre": "Soda Stereo",
                    "idArtista": 123,
                    "genero": "Rock"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "JSON, tipo o datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "timestamp": "2026-11-09T12:00:00Z",

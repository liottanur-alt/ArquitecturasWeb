    {
      "name": "12 Agregar el mismo favorito otra vez",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/usuarios/{{idCliente}}/artistas-favoritos/{{idArtistaPrueba}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [

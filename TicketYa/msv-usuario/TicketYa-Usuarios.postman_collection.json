        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{clienteNombre}}\",\n  \"email\": \"{{clienteEmail}}\",\n  \"dni\": \"{{clienteDni}}\",\n  \"ciudad\": \"{{ciudadPrueba}}\",\n  \"idRol\": {{idRolCliente}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error(\"Se detiene el recorrido para no continuar con IDs incorrectos\"); }",
              "pm.collectionVariables.set(\"idCliente\", pm.response.json().id);",
              "pm.test(\"Rol real y Location\", () => { pm.expect(pm.response.json().idRol).to.eql(Number(pm.collectionVariables.get(\"idRolCliente\"))); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/usuarios/\" + pm.response.json().id); });",
              "pm.test(\"Sin datos de credenciales\", () => { pm.expect(pm.response.json()).not.to.have.property(\"password\"); pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },

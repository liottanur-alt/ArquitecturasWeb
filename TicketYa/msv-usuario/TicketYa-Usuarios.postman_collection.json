{
  "info": {
    "name": "TicketYa Usuarios - Entrega 1",
    "description": "Ejecutar completa en orden. Sin JWT. Consulta roles, captura IDs, genera perfiles únicos y elimina solo los que crea. Una respuesta inesperada detiene el recorrido; si se interrumpe, limpiar los IDs creados siguiendo docs/PRUEBAS-POSTMAN.md. No necesita Eventos para favoritos. CRUD de roles documentado en OpenAPI; la colección conserva los roles inicializados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "idArtistaPrueba",
      "value": "900001"
    }
  ],
  "item": [
    {
      "name": "01 Consultar roles e iniciar datos de la ejecución",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/roles",
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 12);",
              "pm.collectionVariables.set(\"runId\", runId);",
              "[\"idCliente\",\"idOrganizador\",\"idRolCliente\",\"idRolOrganizador\",\"idRolInexistente\"].forEach(k => pm.collectionVariables.unset(k));",
              "const dato = (key, fallback) => pm.iterationData.get(key) || fallback;",
              "pm.collectionVariables.set(\"clienteNombre\", dato(\"clienteNombre\", \"Ana de prueba\"));",
              "pm.collectionVariables.set(\"organizadorNombre\", dato(\"organizadorNombre\", \"Productora de prueba\"));",
              "pm.collectionVariables.set(\"ciudadPrueba\", dato(\"ciudad\", \"Tandil\"));",
              "pm.collectionVariables.set(\"clienteEmail\", \"cliente-\" + runId + \"@example.com\");",
              "pm.collectionVariables.set(\"organizadorEmail\", \"organizador-\" + runId + \"@example.com\");",
              "pm.collectionVariables.set(\"clienteDni\", \"CLI-\" + runId);",
              "pm.collectionVariables.set(\"organizadorDni\", \"ORG-\" + runId);",
              "pm.collectionVariables.set(\"dniDuplicadoEmail\", \"DUP-\" + runId);",
              "pm.collectionVariables.set(\"emailDuplicadoDni\", \"duplicado-\" + runId + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Se detiene el recorrido para no continuar con IDs incorrectos\"); }",
              "const roles = pm.response.json();",
              "for (const [tipo, variable] of [[\"CLIENTE\",\"idRolCliente\"],[\"ORGANIZADOR\",\"idRolOrganizador\"]]) { const rol = roles.find(r => r.name === tipo); pm.test(\"Rol \" + tipo + \" inicializado\", () => pm.expect(rol).to.exist); if (!rol) { pm.execution.setNextRequest(null); throw new Error(\"Falta el rol \" + tipo); } pm.collectionVariables.set(variable, rol.id); }",
              "pm.collectionVariables.set(\"idRolInexistente\", Math.max(0, ...roles.map(r => Number(r.id))) + 1);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consultar rol cliente",

              "pm.collectionVariables.set(\"idOrganizador\", pm.response.json().id);",
              "pm.test(\"Rol real y Location\", () => { pm.expect(pm.response.json().idRol).to.eql(Number(pm.collectionVariables.get(\"idRolOrganizador\"))); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/usuarios/\" + pm.response.json().id); });",
              "pm.test(\"Sin datos de credenciales\", () => { pm.expect(pm.response.json()).not.to.have.property(\"password\"); pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"); });"
            ]

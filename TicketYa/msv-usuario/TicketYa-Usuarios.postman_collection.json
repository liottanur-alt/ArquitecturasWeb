{
  "info": {
    "name": "TicketYa Usuarios - MongoDB y artistas reales",
    "description": "Ejecutar completa en orden: 00 crea un artista temporal en Eventos real, 01 inicializa los usuarios y 33 elimina el artista. Sin JWT. baseUrl=http://localhost:8004 y eventosBaseUrl=http://localhost:8005. modoArtistas=real por defecto; usar simulador para compose.yml de msv-usuario (omite 00 y 33, usa artista 900001). Valida campos completos, tipos, persistencia de perfiles, roles, favoritos y errores. Genera datos unicos y elimina solo sus fixtures. Si se interrumpe, limpiar sus IDs siguiendo docs/PRUEBAS-POSTMAN.md. El CRUD positivo de roles requiere una base descartable: no borra roles compartidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (![\"real\",\"simulador\"].includes(pm.variables.get(\"modoArtistas\"))) { pm.execution.skipRequest(); throw new Error(\"modoArtistas debe ser real o simulador\"); }",
          "const favoritoId = pm.collectionVariables.get(\"idArtistaPrueba\"); if (favoritoId) pm.variables.set(\"idArtistaPrueba\", favoritoId);",
          "const raw = pm.request.body && pm.request.body.mode === 'raw' ? pm.request.body.raw : '';",
          "for (const key of ['idRolCliente', 'idRolOrganizador', 'idRolInexistente']) {",
          "  if (!raw.includes('{{' + key + '}}')) continue;",
          "  const saved = pm.collectionVariables.get(key);",
          "  const id = Number(saved);",
          "  if ((typeof saved !== 'number' && typeof saved !== 'string') || !Number.isSafeInteger(id) || id <= 0) { pm.execution.skipRequest(); throw new Error('Ejecuta primero 01 Consultar roles. ' + key + ' debe contener solo el ID numerico del rol, no el objeto de GET /roles.'); }",
          "  pm.variables.set(key, id);",
          "}",
          "if (raw.includes('\"idRol\"')) {",
          "  let body;",
          "  try { body = JSON.parse(pm.variables.replaceIn(raw)); } catch (e) { pm.execution.skipRequest(); throw new Error('Body JSON incompleto: ejecuta primero la solicitud 01 para inicializar las variables.'); }",
          "  if (typeof body.idRol !== 'number' || !Number.isSafeInteger(body.idRol) || body.idRol <= 0) { pm.execution.skipRequest(); throw new Error('idRol debe ser un numero, por ejemplo 1 para CLIENTE o 2 para ORGANIZADOR en la base actual. No enviar {id: 1} ni el objeto del rol.'); }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const urlActual = pm.variables.replaceIn(pm.request.url.toString()).split('?')[0];",
          "const metodo = pm.request.method;",
          "const status = pm.response.code;",
          "function idValido(id) { pm.expect(Number.isSafeInteger(id) && id > 0).to.eql(true); }",
          "function usuarioValido(u) {",
          " pm.expect(u).to.have.all.keys('id','nombre','email','dni','ciudad','idRol');",
          " idValido(u.id); idValido(u.idRol);",
          " for (const campo of ['nombre','email','dni','ciudad']) pm.expect(u[campo]).to.be.a('string').and.not.empty;",
          "}",
          "function rolValido(r) {",
          " pm.expect(r).to.have.all.keys('id','name'); idValido(r.id);",
          " pm.expect(['CLIENTE','ORGANIZADOR','ADMINISTRADOR','PERSONAL_ACCESO']).to.include(r.name);",
          "}",
          "if (status !== 204) {",
          " pm.test('Respuesta JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/application\\/(?:problem\\+)?json/i));",
          "}",
          "if (status >= 400) {",
          " pm.test('Error con estado correcto y sin traza interna', () => {",
          "  const error = pm.response.json(); pm.expect(error.status).to.eql(status);",
          "  pm.expect(error).not.to.have.property('trace'); pm.expect(error).not.to.have.property('stackTrace');",
          " });",
          "}",
          "if (status === 200 && /\\/roles(?:\\/\\d+)?$/.test(urlActual)) {",
          " const body = pm.response.json();",
          " pm.test('Roles: estructura, IDs y tipos correctos', () => {",
          "  if (Array.isArray(body)) {",
          "   body.forEach(rolValido);",
          "   pm.expect(new Set(body.map(r => r.id)).size).to.eql(body.length);",
          "   pm.expect(body.map(r => r.name)).to.have.members(['CLIENTE','ORGANIZADOR','ADMINISTRADOR','PERSONAL_ACCESO']);",
          "  } else {",
          "   rolValido(body); pm.expect(body.id).to.eql(Number(urlActual.split('/').pop()));",
          "  }",
          " });",
          "}",
          "if ((status === 200 || status === 201) && /\\/usuarios(?:\\/\\d+)?$/.test(urlActual)) {",
          " const body = pm.response.json();",
          " pm.test('Usuarios: campos completos y tipos correctos', () => {",
          "  if (Array.isArray(body)) {",
          "   body.forEach(usuarioValido); pm.expect(new Set(body.map(u => u.id)).size).to.eql(body.length);",
          "  } else usuarioValido(body);",
          " });",
          " if (metodo === 'POST' || metodo === 'PUT') {",
          "  const enviado = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "  pm.test('El perfil devuelve exactamente los datos enviados', () => {",
          "   for (const campo of ['nombre','email','dni','ciudad','idRol']) pm.expect(body[campo]).to.eql(enviado[campo]);",
          "   if (metodo === 'PUT') pm.expect(body.id).to.eql(Number(urlActual.split('/').pop()));",
          "  });",
          "  pm.collectionVariables.set('perfilEsperado_' + body.id, JSON.stringify(body));",
          " } else {",
          "  pm.test('Los perfiles consultados coinciden con lo guardado', () => {",
          "   for (const usuario of (Array.isArray(body) ? body : [body])) {",
          "    const esperado = pm.collectionVariables.get('perfilEsperado_' + usuario.id);",
          "    if (esperado) pm.expect(usuario).to.deep.eql(JSON.parse(esperado));",
          "   }",
          "   if (!Array.isArray(body)) pm.expect(body.id).to.eql(Number(urlActual.split('/').pop()));",
          "  });",
          " }",
          "}",
          "if (status === 200 && /\\/artistas-favoritos$/.test(urlActual)) {",
          " const favoritos = pm.response.json();",
          " pm.test('Favoritos: IDs y datos exactos del catalogo, sin duplicados', () => {",
          "  pm.expect(favoritos).to.be.an('array');",
          "  pm.expect(new Set(favoritos.map(a => a.idArtista)).size).to.eql(favoritos.length);",
          "  favoritos.forEach(a => {",
          "   pm.expect(a).to.have.all.keys('idArtista','nombre','genero');",
          "   pm.expect(a.idArtista).to.eql(Number(pm.collectionVariables.get('idArtistaPrueba')));",
          "   pm.expect(a.nombre).to.eql(pm.collectionVariables.get('artistaNombreEsperado'));",
          "   pm.expect(a.genero).to.eql(pm.collectionVariables.get('artistaGeneroEsperado'));",
          "  });",
          " });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8004"
    },
    {
      "key": "eventosBaseUrl",
      "value": "http://localhost:8005"
    },
    {
      "key": "modoArtistas",
      "value": "real"
    },
    {
      "key": "idArtistaPrueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Crear artista temporal en Eventos real",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{eventosBaseUrl}}/api/artistas",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"{{artistaNombreEsperado}}\",\"genero\":\"Rock\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Crea solo el artista de esta ejecucion. En modo simulador se omite y se usa el artista 900001."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('modoArtistas') === 'simulador') {",
              " pm.collectionVariables.set('idArtistaPrueba', 900001);",
              " pm.collectionVariables.set('artistaNombreEsperado', 'Soda Stereo');",
              " pm.collectionVariables.set('artistaGeneroEsperado', 'Rock');",
              " pm.execution.skipRequest();",
              "} else {",
              " pm.collectionVariables.unset('idArtistaPrueba');",
              " pm.collectionVariables.set('artistaNombreEsperado', 'Artista Postman ' + pm.variables.replaceIn('{{$guid}}'));",
              " pm.collectionVariables.set('artistaGeneroEsperado', 'Rock');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 artista real', () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error('No se pudo crear el artista temporal en Eventos'); }",
              "const artista = pm.response.json();",
              "pm.test('Artista creado con ID numerico y datos exactos', () => {",
              " pm.expect(Number.isSafeInteger(artista.id) && artista.id > 0).to.eql(true);",
              " pm.expect(artista.nombre).to.eql(pm.collectionVariables.get('artistaNombreEsperado'));",
              " pm.expect(artista.genero).to.eql('Rock');",
              "});",
              "pm.collectionVariables.set('idArtistaPrueba', artista.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Consultar roles e iniciar datos de la ejecución",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/roles",
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 12);",
              "pm.collectionVariables.set(\"runId\", runId);",
              "[\"idCliente\",\"idOrganizador\",\"idRolCliente\",\"idRolOrganizador\",\"idRolInexistente\"].forEach(k => pm.collectionVariables.unset(k));",
              "const dato = (key, fallback) => pm.iterationData.get(key) || fallback;",
              "pm.collectionVariables.set(\"clienteNombre\", dato(\"clienteNombre\", \"Ana de prueba\"));",
              "pm.collectionVariables.set(\"organizadorNombre\", dato(\"organizadorNombre\", \"Productora de prueba\"));",
              "pm.collectionVariables.set(\"ciudadPrueba\", dato(\"ciudad\", \"Tandil\"));",
              "pm.collectionVariables.set(\"clienteEmail\", \"cliente-\" + runId + \"@example.com\");",
              "pm.collectionVariables.set(\"organizadorEmail\", \"organizador-\" + runId + \"@example.com\");",
              "pm.collectionVariables.set(\"clienteDni\", \"CLI-\" + runId);",
              "pm.collectionVariables.set(\"organizadorDni\", \"ORG-\" + runId);",
              "pm.collectionVariables.set(\"dniDuplicadoEmail\", \"DUP-\" + runId);",
              "pm.collectionVariables.set(\"emailDuplicadoDni\", \"duplicado-\" + runId + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Se detiene el recorrido para no continuar con IDs incorrectos\"); }",
              "const roles = pm.response.json();",
              "for (const [tipo, variable] of [[\"CLIENTE\",\"idRolCliente\"],[\"ORGANIZADOR\",\"idRolOrganizador\"]]) { const rol = roles.find(r => r.name === tipo); pm.test(\"Rol \" + tipo + \" inicializado\", () => pm.expect(rol).to.exist); if (!rol) { pm.execution.setNextRequest(null); throw new Error(\"Falta el rol \" + tipo); } pm.collectionVariables.set(variable, rol.id); }",
              "pm.collectionVariables.set(\"idRolInexistente\", Math.max(0, ...roles.map(r => Number(r.id))) + 1);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consultar rol cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/roles/{{idRolCliente}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Se detiene el recorrido para no continuar con IDs incorrectos\"); }",
              "pm.test(\"Tipo CLIENTE\", () => pm.expect(pm.response.json().name).to.eql(\"CLIENTE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear cliente",
      "request": {

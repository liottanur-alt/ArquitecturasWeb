# Copiar a .env en la raiz antes de ejecutar docker compose.
# .env ya esta excluido por .gitignore: no subir secretos al repositorio.

# Secreto HS256 compartido por Usuarios y Gateway para firmar y validar JWT. Minimo 32 bytes.
# Debe mantenerse estable entre reinicios para no invalidar tokens emitidos.
JWT_SECRET=
# Clave del administrador de prueba que crea el perfil dev de Usuarios.
# Reemplazar el valor por defecto 1234 usado por la aplicacion fuera de Compose.
ADMIN_SEED_PASSWORD=

# Puerto local para la interfaz web construida por Docker Compose.
FRONTEND_PORT=8081

{
  "info": {
    "name": "TicketYa Eventos - Entrega 1",
    "description": "Ejecutar completa en orden. Usa la API directa en 8005, sin JWT. Cada iteración crea lugar/artista/evento propios, captura IDs y limpia evento antes que sus relaciones. Se detiene ante una respuesta inesperada. idOrganizadorPrueba es una referencia externa ilustrativa: Eventos no la valida en Usuarios. Ver docs/PRUEBAS-POSTMAN.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8005"
    },
    {
      "key": "idOrganizadorPrueba",
      "value": "900001"
    }
  ],
  "item": [
    {
      "name": "01 Crear lugar e iniciar datos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lugares",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{nombreLugarPrueba}}\",\n  \"direccion\": \"Calle prueba 123\",\n  \"latitud\": -37.3288,\n  \"longitud\": -59.1367,\n  \"ciudad\": \"{{ciudadPrueba}}\",\n  \"tipo\": \"TEATRO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0,12);",
              "pm.collectionVariables.set(\"runId\", runId);",
              "[\"idLugar\",\"idArtista\",\"idEvento\"].forEach(k => pm.collectionVariables.unset(k));",
              "const dato = (k,f) => pm.iterationData.get(k) || f;",
              "pm.collectionVariables.set(\"nombreLugarPrueba\", dato(\"nombreLugar\",\"Teatro prueba\") + \" \" + runId);",
              "pm.collectionVariables.set(\"nombreArtistaPrueba\", dato(\"nombreArtista\",\"Banda prueba\") + \" \" + runId);",
              "pm.collectionVariables.set(\"nombreEventoPrueba\", dato(\"nombreEvento\",\"Recital prueba\") + \" \" + runId);",
              "pm.collectionVariables.set(\"ciudadPrueba\", dato(\"ciudad\",\"Tandil\"));",
              "pm.collectionVariables.set(\"fechaEvento\", new Date(Date.now() + 7*86400000).toISOString().slice(0,19));",
              "pm.collectionVariables.set(\"fechaDesde\", new Date(Date.now() - 86400000).toISOString().slice(0,19));",
              "pm.collectionVariables.set(\"fechaHasta\", new Date(Date.now() + 8*86400000).toISOString().slice(0,19));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error(\"Respuesta inesperada: se detiene el recorrido para proteger los IDs de prueba\"); }",
              "pm.collectionVariables.set(\"idLugar\", pm.response.json().id);",
              "pm.test(\"ID generado positivo\", () => pm.expect(pm.response.json().id).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Consultar lugar",

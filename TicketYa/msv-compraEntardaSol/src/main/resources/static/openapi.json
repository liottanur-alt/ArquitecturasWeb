{
  "openapi": "3.0.3",
  "info": {
    "title": "TicketYa - Compras, entradas y solicitudes",
    "version": "1.2.0",
    "description": "Microservicio de compra (HU-08 a HU-14) con validacion local de JWT HS256 (issuer msv-usuario). El cliente se toma del sub del token; las rutas interno exigen ROLE_SERVICIO_INTERNO."
  },
  "servers": [
    {
      "url": "http://localhost:8003",
      "description": "Ejecucion local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Compras"
    },
    {
      "name": "Entradas"
    },
    {
      "name": "Solicitudes"
    }
  ],
  "paths": {
    "/compras": {
      "post": {
        "tags": [
          "Compras"
        ],
        "summary": "Crear una compra y su reserva",
        "operationId": "crearCompra",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompraRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compra creada o recuperada por idempotencia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompraResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/compras/{id}": {
      "get": {
        "tags": [
          "Compras"
        ],
        "summary": "Consultar una compra",
        "operationId": "buscarCompra",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCompra"
          }
        ],
        "responses": {
          "200": {
            "description": "Compra encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompraResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/compras/cliente/{idCliente}": {
      "get": {
        "tags": [
          "Compras"
        ],
        "summary": "Listar compras de un cliente",
        "operationId": "listarComprasPorCliente",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCliente"
          }
        ],
        "responses": {
          "200": {
            "description": "Compras del cliente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompraResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/compras/{id}/pago": {
      "put": {
        "tags": [
          "Compras"
        ],
        "summary": "Procesar el pago simulado",
        "operationId": "procesarPago",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCompra"
          },
          {
            "name": "aprobado",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            },
            "description": "true aprueba; false rechaza y libera la reserva"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado del pago",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompraResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/compras/eventos/{idEvento}/cancelacion": {
      "post": {
        "tags": [
          "Compras"
        ],
        "summary": "Cancelar un evento, cerrar inventario y reintegrar las entradas vendidas",
        "operationId": "cancelarEvento",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdEvento"
          }
        ],
        "responses": {
          "200": {
            "description": "Resumen de la cancelacion completa: catalogo, compras, reintegros e inventario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelacionEventoResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/entradas/{id}": {
      "get": {
        "tags": [
          "Entradas"
        ],
        "summary": "Consultar una entrada por ID",
        "operationId": "buscarEntrada",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdEntrada"
          }
        ],
        "responses": {
          "200": {
            "description": "Entrada encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntradaResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/entradas/qr/{qr}": {
      "get": {
        "tags": [
          "Entradas"
        ],
        "summary": "Consultar una entrada por QR",
        "operationId": "buscarEntradaPorQr",
        "parameters": [
          {
            "$ref": "#/components/parameters/Qr"
          }
        ],
        "responses": {
          "200": {
            "description": "Entrada encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntradaResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/entradas/compra/{idCompra}": {
      "get": {
        "tags": [
          "Entradas"
        ],
        "summary": "Listar entradas de una compra",
        "operationId": "listarEntradasPorCompra",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCompra"
          }
        ],
        "responses": {
          "200": {
            "description": "Entradas de la compra",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntradaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/entradas/cliente/{idCliente}": {
      "get": {
        "tags": [
          "Entradas"
        ],
        "summary": "Listar entradas de un cliente",
        "operationId": "listarEntradasPorCliente",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCliente"
          }
        ],
        "responses": {
          "200": {
            "description": "Entradas del cliente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntradaResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/entradas/{id}/uso": {
      "patch": {
        "tags": [
          "Entradas"
        ],
        "summary": "Marcar una entrada como utilizada",
        "operationId": "marcarEntradaUsada",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdEntrada"
          },
          {
            "$ref": "#/components/parameters/IdEventoEscaneo"
          }
        ],
        "responses": {
          "200": {
            "description": "Entrada escaneada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntradaResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/entradas/qr/{qr}/uso": {
      "patch": {
        "tags": [
          "Entradas"
        ],
        "summary": "Marcar una entrada como utilizada por QR",
        "operationId": "marcarEntradaUsadaPorQr",
        "parameters": [
          {
            "$ref": "#/components/parameters/Qr"
          },
          {
            "$ref": "#/components/parameters/IdEventoEscaneo"
          }
        ],
        "responses": {
          "200": {
            "description": "Entrada escaneada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntradaResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/solicitudes": {
      "post": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Solicitar la devolucion de una entrada",
        "operationId": "crearSolicitud",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud pendiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolicitudResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/solicitudes/{id}": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Consultar una solicitud",
        "operationId": "buscarSolicitud",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdSolicitud"
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitud encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolicitudResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/solicitudes/entrada/{idEntrada}": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Listar solicitudes de una entrada",
        "operationId": "listarSolicitudesPorEntrada",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdEntrada"
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes de la entrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SolicitudResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes/pendientes": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Listar solicitudes pendientes",
        "operationId": "listarSolicitudesPendientes",
        "responses": {
          "200": {
            "description": "Solicitudes pendientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SolicitudResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes/cliente/{idCliente}": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Listar solicitudes de un cliente",
        "operationId": "listarSolicitudesPorCliente",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdCliente"
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes del cliente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SolicitudResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/solicitudes/{id}/resolver": {
      "put": {
        "tags": [
          "Solicitudes"
        ],
        "summary": "Aprobar o rechazar una solicitud",
        "operationId": "resolverSolicitud",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdSolicitud"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudResolucion"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Solicitud resuelta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SolicitudResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/interno/recomendaciones/clientes/{idCliente}": {
      "get": {
        "tags": [
          "Interno"
        ],
        "operationId": "recomendaciones_compras_en_comun",
        "summary": "Candidatos agregados por compras en comun",
        "description": "No se publica por Gateway. Una relacion cliente-evento cuenta si la compra esta APROBADA y queda una entrada PAGA, SOLICITUD_DEVOLUCION o DEVOLUCION_RECHAZADA. Excluye entradas reintegradas y compras no confirmadas en todos los pasos. Cada otro cliente cuenta una sola vez por candidato. Excluye eventos del historial propio. No devuelve identidades ni compras individuales. Sin historial o coincidencias devuelve []. Usuarios valida luego la disponibilidad en Eventos.",
        "parameters": [
          {
            "name": "idCliente",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eventos, cantidades agregadas y referencia al historial propio.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompraEnComunResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID de cliente no positivo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/interno/recomendaciones/clientes/{idCliente}/historial-valido": {
      "get": {
        "responses": {
          "400": {
            "description": "ID de cliente no positivo o invalido"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistorialValidoResponse"
                }
              }
            },
            "description": "Historial valido, posiblemente vacio"
          }
        },
        "tags": [
          "Recomendaciones internas"
        ],
        "operationId": "historialValido",
        "summary": "IDs de eventos del historial valido propio",
        "description": "Solo comunicacion entre servicios; no enrutable por Gateway. Compras APROBADA con al menos una entrada PAGA, SOLICITUD_DEVOLUCION o DEVOLUCION_RECHAZADA. No expone compras ni clientes ajenos. Un evento por ID, orden ascendente.",
        "parameters": [
          {
            "schema": {
              "format": "int64",
              "type": "integer",
              "minimum": 1
            },
            "required": true,
            "in": "path",
            "name": "idCliente"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT HS256 emitido por msv-usuario. Las rutas interno exigen roles=[SERVICIO_INTERNO]."
      }
    },
    "parameters": {
      "IdCompra": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdEntrada": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdSolicitud": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdCliente": {
        "name": "idCliente",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "IdEventoEscaneo": {
        "name": "idEvento",
        "in": "query",
        "required": true,
        "description": "ID del evento en cuyo ingreso se escanea la entrada",
        "schema": { "type": "integer", "format": "int64", "minimum": 1 }
      },
      "IdEvento": {
        "name": "idEvento",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "Qr": {
        "name": "qr",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Datos invalidos o pedido incompleto",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "La entrada no pertenece al cliente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso inexistente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto de negocio o idempotencia",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "BadGateway": {
        "description": "Un servicio requerido devolvio un error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Un servicio requerido no esta disponible",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "CompraRequest": {
        "type": "object",
        "required": [
          "claveIdempotencia",
          "idCliente",
          "idEvento",
          "idSector",
          "medioDePago"
        ],
        "properties": {
          "claveIdempotencia": {
            "type": "string",
            "maxLength": 100,
            "example": "compra-2026-0001"
          },
          "idCliente": {
            "type": "integer",
            "format": "int64",
            "example": 12
          },
          "idEvento": {
            "type": "integer",
            "format": "int64",
            "example": 40
          },
          "idSector": {
            "type": "integer",
            "format": "int64",
            "example": 7
          },
          "idsAsientos": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "example": [
              101,
              102
            ]
          },
          "cantidadEntradas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "example": 2
          },
          "medioDePago": {
            "type": "string",
            "example": "TARJETA"
          }
        },
        "description": "Se debe informar idsAsientos no vacio o cantidadEntradas positivo."
      },
      "CompraResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "idCliente": {
            "type": "integer",
            "format": "int64",
            "example": 12
          },
          "idEvento": {
            "type": "integer",
            "format": "int64",
            "example": 40
          },
          "idSector": {
            "type": "integer",
            "format": "int64",
            "example": 7
          },
          "cantidadEntradas": {
            "type": "integer",
            "format": "int64",
            "example": 2
          },
          "medioDePago": {
            "type": "string",
            "example": "TARJETA"
          },
          "descripcion": {
            "type": "string",
            "example": "Compra pendiente de pago"
          },
          "estadoCompra": {
            "type": "string",
            "enum": [
              "PENDIENTE",
              "APROBADA",
              "RECHAZADA",
              "EXPIRADA",
              "CANCELADA"
            ]
          },
          "claveIdempotencia": {
            "type": "string",
            "example": "compra-2026-0001"
          },
          "idReserva": {
            "type": "integer",
            "format": "int64",
            "example": 500
          },
          "precioUnitario": {
            "type": "number",
            "format": "double",
            "example": 1500
          },
          "importeTotal": {
            "type": "number",
            "format": "double",
            "example": 3000
          },
          "referenciaPago": {
            "type": "string",
            "nullable": true,
            "example": "SIM-..."
          },
          "referenciaReintegro": {
            "type": "string",
            "nullable": true,
            "example": "SIM-REF-..."
          },
          "estadoReintegro": {
            "type": "string",
            "nullable": true,
            "enum": [
              "PENDIENTE",

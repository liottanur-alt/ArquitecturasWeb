---
import '../styles/global.css';
import '../styles/catalog.css';
import '../styles/event-navigation.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ArrowRight, ArrowUpRight, CalendarDays, Drama, Heart, MapPin, Mic2, Music2, Search, Sparkles, Ticket, Trophy } from '@lucide/astro';

const categories = [
  { label: 'Recitales', value: 'RECITAL', icon: Music2, color: 'purple' },
  { label: 'Teatro', value: 'TEATRO', icon: Drama, color: 'rose' },
  { label: 'Deportes', value: 'DEPORTE', icon: Trophy, color: 'green' },
  { label: 'Festivales', value: 'FESTIVAL', icon: Sparkles, color: 'orange' },
  { label: 'Conferencias', value: 'CONFERENCIA', icon: Mic2, color: 'blue' },
  { label: 'Otros', value: 'OTRO', icon: Ticket, color: 'neutral' },
];
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#171327" />
  <meta name="description" content="Descubrí los próximos recitales, obras de teatro, encuentros y partidos. Encontrá tus entradas en TicketYa." />
  <title>TicketYa — Encontrá tu próximo plan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="home-page">
  <a href="#explorar" class="skip-link">Ir al buscador</a>
  <SiteHeader />
  <div class="home-stage">
    
    <main id="home-main">
      <section class="home-shell home-featured" aria-labelledby="featured-title">
        <div class="home-section-head featured-head">
          <div><p class="home-kicker">EVENTOS EN VIVO</p><h1 id="featured-title">Destacados</h1></div>
          <a href="#catalogo">Ver eventos <ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
        <div id="featured-grid" class="featured-grid" aria-busy="true" aria-live="off">
          {[0, 1, 2].map(() => <div class="featured-tile home-skeleton" aria-hidden="true"></div>)}
        </div>
        <p id="featured-feedback" class="featured-feedback" hidden></p>
      </section>
      <section class="home-shell home-search" id="explorar" aria-label="Buscador de eventos">
        <form id="home-search-form" role="search">
          <label class="home-field home-query"><Search size={20} aria-hidden="true" /><span>¿Qué querés ver?</span><input id="query" type="search" placeholder="Evento, artista o lugar" autocomplete="off" /></label>
          <label class="home-field"><MapPin size={18} aria-hidden="true" /><span>Ciudad</span><input id="city" list="catalog-cities" placeholder="Todas las ciudades" autocomplete="off" /></label>
          <label class="home-field"><Ticket size={18} aria-hidden="true" /><span>Categoría</span><select id="home-category"><option value="">Todas</option>{categories.map(category => <option value={category.value}>{category.label}</option>)}</select></label>
          <label class="home-field"><CalendarDays size={18} aria-hidden="true" /><span>Fecha</span><input id="home-date" type="date" /></label>
          <button class="home-button" type="submit">Buscar <ArrowRight size={17} aria-hidden="true" /></button>
        </form>
        <datalist id="catalog-cities"></datalist>
        <div class="home-chips" aria-label="Filtros rápidos">
          <button type="button" data-date-filter="today" aria-pressed="false">Hoy</button>
          <button type="button" data-date-filter="weekend" aria-pressed="false">Este fin de semana</button>
          {categories.slice(0, 3).map(category => <button type="button" data-category-filter={category.value} aria-pressed="false">{category.label}</button>)}
          <button type="button" id="limited-filter" aria-pressed="false">Últimas entradas</button>
          <button type="button" id="clear-filters" hidden>Limpiar filtros</button>
        </div>
      </section>
      <section class="home-shell home-personalized" id="para-vos" aria-labelledby="personalized-title" hidden>
        <div class="home-section-head">
          <h2 id="personalized-title">Para vos</h2>
          <a href="/perfil/#datos">Editar preferencias <ArrowUpRight size={16} aria-hidden="true" /></a>
        </div>
        <p id="home-recommendation-status" class="home-recommendation-status" role="status"></p>
        <details class="home-recommendation-help">
          <summary>¿Cómo se eligen las recomendaciones?</summary>
          <p>TicketYa busca eventos futuros con cupo según tus categorías, ciudad y artistas favoritos. También busca otros eventos comprados por personas que tienen una compra aprobada en común con vos. Los eventos que ya compraste se excluyen.</p>
        </details>
        <div class="home-grid" id="home-recommendation-grid"></div>
        <button type="button" class="home-button" id="retry-home-recommendations" hidden>Reintentar</button>
      </section>
      <section class="home-shell home-catalog" id="catalogo" aria-labelledby="catalog-title">
        <div class="home-section-head"><h2 id="catalog-title">Próximos eventos</h2><p id="catalog-status" role="status"></p></div>
        <div id="catalog-state" class="home-feedback" hidden>
          <h3 id="catalog-state-title"></h3><p id="catalog-error" role="alert"></p>
          <button type="button" id="retry-catalog" class="home-button" hidden>Reintentar</button>
        </div>
        <div class="home-grid" id="event-grid" aria-busy="true">
          {[0, 1, 2, 3].map(() => <div class="home-card home-card-skeleton" aria-hidden="true"></div>)}
        </div>
        <nav class="home-pagination" aria-label="Páginas de eventos">
          <button id="catalog-prev" type="button" disabled>Anterior</button><span id="catalog-page"></span><button id="catalog-next" type="button" disabled>Siguiente</button>
        </nav>
      </section>
      <section class="home-shell home-categories" id="categorias" aria-labelledby="category-title">
        <div class="home-section-head"><h2 id="category-title">Explorar por categoría</h2></div>
        <div class="home-category-grid">
          {categories.map(({ label, value, icon: Icon, color }) => (
            <button type="button" class="home-category" data-color={color} data-category-filter={value} data-jump aria-pressed="false">
              <Icon size={25} aria-hidden="true" /><span>{label}</span><ArrowUpRight size={17} aria-hidden="true" />
            </button>
          ))}
        </div>
      </section>
      <noscript><p class="home-shell">Activá JavaScript para consultar el catálogo de TicketYa.</p></noscript>
    </main>
  </div>
  <SiteFooter />
  <div id="toast" role="status"></div>
  <template id="featured-template">
    <a class="featured-tile" data-event>
      <img alt="" width="960" height="600" />
      <div class="featured-copy">
        <span data-category></span><h2 data-title></h2><p data-location></p>
        <div><time data-date></time><span class="featured-action" data-action></span><ArrowUpRight size={18} aria-hidden="true" /></div>
      </div>
    </a>
  </template>
  <template id="event-card-template">
    <article class="home-card" data-card>
      <a class="home-card-photo" data-event tabindex="-1" aria-hidden="true"><img alt="" width="600" height="420" loading="lazy" /></a>
      <span class="home-card-badge" data-state hidden></span>
      <button type="button" class="home-favorite" data-favorite aria-label="Guardar evento en favoritos" aria-pressed="false"><Heart size={19} aria-hidden="true" /></button>
      <div class="home-card-copy">
        <div class="home-card-meta"><time data-date></time><span data-category></span></div>
        <h3><a data-title data-event></a></h3>
        <p class="home-location"><MapPin size={15} aria-hidden="true" /><span data-location></span></p>
        <p class="home-reason" data-reason hidden></p>
        <div class="home-card-bottom"><strong data-price></strong><a class="home-card-action" data-event><span data-action></span><ArrowUpRight size={16} aria-hidden="true" /></a></div>
      </div>
    </article>
  </template>
  <script>import '../scripts/home';</script>
</body>
</html>

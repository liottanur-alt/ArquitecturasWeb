---
import '../../styles/global.css';
import AccountMenu from '../../components/AccountMenu.astro';
import '../../styles/event.css';
import { catalog } from '../../data/events';
import { ArrowLeft, ArrowRight, ArrowUpRight, CalendarDays, MapPin, Ticket, Check, Minus, Plus, X, Info, ShieldCheck, Armchair } from '@lucide/astro';
export function getStaticPaths() {
  return catalog.map(event => ({ params: { id: String(event.id) }, props: { event } }));
}
const { event } = Astro.props;
const money = (price: number) => '$ ' + price.toLocaleString('es-AR');
---
<!doctype html>
<html lang="es-AR">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={`${event.title}: ${event.fullDate}, ${event.venue}. Elegí tu sector y tus entradas en TicketYa.`}/><meta name="theme-color" content="#2055f5"/><title>{event.title} — TicketYa</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head>
<body class="detail-page">
  <a class="skip-link" href="#seleccion">Saltar a selección de entradas</a>
  <header class="site-header"><a href="/" class="brand" aria-label="TicketYa, inicio"><span class="brand-symbol"><Ticket size={22}/></span>ticket<span>ya</span><span class="brand-dot">®</span></a><a class="back-home" href="/#explorar"><ArrowLeft size={16}/> Seguir explorando</a><AccountMenu /></header>
  <main class="wrap detail-main">
    <nav class="breadcrumbs" aria-label="Ubicación"><a href="/">Inicio</a><span>/</span><a href="/#explorar">Eventos</a><span>/</span><span aria-current="page">{event.title}</span></nav>
    <section class="event-banner" aria-labelledby="event-title"><img src={event.image} alt="" fetchpriority="high"/><div class="banner-overlay"></div><div class="banner-content"><span class="event-pill">{event.category}</span>{event.high && <span class="event-pill demand-pill">↗ Alta demanda</span>}<h1 id="event-title">{event.title}</h1><p>{event.artist}</p><div class="banner-meta"><span><CalendarDays size={16}/>{event.fullDate} · 2026</span><span><MapPin size={16}/>{event.venue} · {event.city}</span></div></div><span class="banner-stamp"><strong>{event.date.split(' ')[0]}</strong>{event.date.split(' ')[1]}<small>2026</small></span></section>
    <div class="detail-layout">
      <div class="detail-content">
        <section class="about-event"><span class="eyebrow">HAY QUE ESTAR AHÍ</span><h2>Tu lugar en esta historia.</h2><p>{event.description}</p><div class="event-facts"><span><Ticket size={17}/>{event.seating}</span><span><Info size={17}/> Hasta {event.maxTickets} entradas por persona</span></div></section>
        <section id="seleccion" class="booking-section" aria-labelledby="booking-title">
          <div class="booking-heading"><span class="step-circle">01</span><div><h2 id="booking-title">Elegí dónde vivirlo.</h2><p>Seleccioná un sector para ver sus ubicaciones.</p></div></div>
          <div class="sector-list" role="group" aria-label="Sectores disponibles">
            {event.sectors.map((sector,i) => <button class:list={['sector-option',{selected:i===0}]} data-sector={sector.id} aria-pressed={i===0} aria-controls={`panel-${sector.id}`}><span class="sector-radio"><Check size={12}/></span><span class="sector-name"><strong>{sector.name}</strong><small>{sector.type==='numerado'?'Asientos numerados':'Ubicación libre'}</small></span><span class="sector-price">{money(sector.price)}<small>por entrada</small></span></button>)}
          </div>
          {event.sectors.map((sector,i) => <section id={`panel-${sector.id}`} data-panel={sector.id} hidden={i!==0} aria-label={sector.name} class="sector-panel">
            <div class="panel-heading"><div><h3>{sector.type==='numerado'?'Tu asiento te está esperando.':'Un lugar, mil maneras de vivirlo.'}</h3><p>{sector.description}</p></div><span class="availability"><span></span>{sector.available} disponibles</span></div>
            {sector.type==='general' ? <div class="general-selector"><div class="general-illustration" aria-hidden="true"><Ticket size={34}/><span>{sector.name}</span><small>SIN NUMERAR</small></div><div class="quantity-info"><h4>¿Cuántas entradas querés?</h4><p>Ingresá con tu grupo y elegí tu lugar dentro del sector.</p><div class="quantity-controls"><button class="icon-button" data-minus={sector.id} aria-label={`Quitar una entrada de ${sector.name}`} disabled><Minus size={16}/></button><output data-quantity={sector.id} aria-live="polite">0</output><button class="icon-button" data-plus={sector.id} aria-label={`Agregar una entrada de ${sector.name}`}><Plus size={16}/></button></div><small>Máximo {event.maxTickets} entradas en total por persona.</small></div></div> : <div class="numbered-selector"><div class="seat-toolbar"><div class="seat-legend"><span><i class="available-dot"></i>Disponible</span><span><i class="selected-dot"></i>Tu selección</span><span><i class="occupied-dot"></i>Ocupado</span></div><span class="map-hint">Deslizá para ver el mapa completo</span></div><div class="seat-map-scroll" tabindex="0" aria-label={`Mapa de asientos de ${sector.name}. Desplazamiento horizontal disponible`}><div class="seat-map"><div class="stage">ESCENARIO<span>Las mejores historias pasan acá</span></div><div class="seat-rows">{Array.from({length:sector.rows!},(_,row) => {const letter=String.fromCharCode(65+row);return <div class="seat-row"><span class="row-label" aria-hidden="true">{letter}</span>{Array.from({length:sector.columns!},(_,col) => {const seat=`${letter}-${col+1}`;const occupied=sector.occupied!.includes(seat);return <button class:list={['seat',{'aisle-after':col===5}]} data-seat={seat} data-seat-sector={sector.id} disabled={occupied} aria-pressed="false" aria-label={`${sector.name}, fila ${letter}, asiento ${col+1}${occupied?', ocupado':''}`}><Armchair size={20}/><span>{col+1}</span></button>;})}<span class="row-label" aria-hidden="true">{letter}</span></div>;})}</div><div class="map-bottom">INGRESO AL SECTOR</div></div></div><p class="seat-help"><Info size={15}/> Tocá un asiento disponible para elegirlo. Volvé a tocarlo para quitarlo.</p></div>}
          </section>)}
          <p class="selection-message" id="selection-message" role="status" aria-live="polite"></p>
          <div class="booking-note"><Info size={18}/><p>Estás explorando un boceto. La disponibilidad es de ejemplo y tu selección todavía no reserva lugares.</p></div>
        </section>
      </div>
      <aside class="order-summary" aria-labelledby="summary-title"><div class="summary-top"><span class="eyebrow">UN PASO MÁS CERCA</span><Ticket size={24}/></div><h2 id="summary-title">Tu próximo momento.</h2><p class="summary-event">{event.title}</p><p class="summary-date">{event.fullDate}</p><div class="summary-empty" id="summary-empty"><Armchair size={30}/><p>Tu plan empieza acá.</p><span>Elegí un sector y agregá tus entradas.</span></div><div id="summary-items"></div><div class="summary-totals" aria-live="polite" aria-atomic="true"><div><span>Entradas <span id="ticket-count">(0)</span></span><strong id="subtotal">$ 0</strong></div><div class="summary-total"><span>Total</span><strong id="total">$ 0</strong></div></div><p class="price-note">Precio de ejemplo, sin cargos adicionales en este boceto.</p><button class="button button-blue review-button" id="review-selection" disabled>Revisar selección <ArrowRight size={18}/></button><button id="clear-selection" class="clear-selection" hidden>Limpiar selección</button><div class="summary-foot"><ShieldCheck size={16}/><span>Sin cobros ni reservas en esta vista previa.</span></div></aside>
    </div>
    <section class="detail-bottom"><span class="eyebrow">TU PLAN, A TU MANERA</span><h2>Hay momentos que se eligen.<br/>Y otros que te eligen a vos.</h2><a href="/#explorar" class="text-link">Descubrí más eventos <ArrowUpRight size={17}/></a></section>
  </main>
  <footer class="site-footer wrap"><a class="brand" href="/">ticket<span>ya</span><span class="brand-dot">®</span></a><p>Hay que estar ahí.</p><span>© 2026 TicketYa · Eventos de ejemplo</span><a href="/">Volver al inicio <ArrowUpRight size={15}/></a></footer>
  <dialog id="review-dialog" aria-labelledby="review-title"><div class="dialog-head"><span class="eyebrow">ASÍ SE VE TU PLAN</span><button class="icon-button" id="close-review" aria-label="Cerrar resumen"><X size={22}/></button></div><div class="dialog-body"><span class="review-icon"><Check size={25}/></span><h2 id="review-title">Una gran elección.</h2><p>{event.title} · {event.fullDate}</p><div id="review-items"></div><div class="review-total"><span>Total de ejemplo</span><strong id="review-total"></strong></div><p class="demo-note">Esta es una simulación de tu selección. No se reservaron entradas ni se realizó ningún pago. Podés guardar la selección en el carrito para continuar después.</p><button class="button button-blue" id="save-cart">Guardar en carrito <Ticket size={18}/></button><p id="save-cart-status" role="status" aria-live="polite"></p><a id="view-cart" class="text-link" href="/perfil/#carrito" hidden>Ver mi carrito <ArrowRight size={16}/></a><button class="button button-blue" id="keep-choosing">Seguir eligiendo <ArrowRight size={18}/></button></div></dialog>
  <script type="application/json" id="event-data" set:html={JSON.stringify(event).replace(/</g,'\\u003c')}></script>
  <script>import '../../scripts/event';</script>
</body>
</html>

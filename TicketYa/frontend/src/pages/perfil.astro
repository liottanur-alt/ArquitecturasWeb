---
import "../styles/global.css";
import "../styles/profile.css";
import "../styles/tickets.css";
import "../styles/account.css";
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
    Ticket,
    ArrowUpRight,
    ArrowRight,
    UserRound,
    ShoppingBag,
    ShoppingCart,
    Mail,
    MapPin,
    IdCard,
    Info,
    X,
    Check,
    Plus,
    LogOut,
    CalendarDays,
    Bell,
    SlidersHorizontal,
} from "@lucide/astro";
---

<!doctype html>
<html lang="es-AR">
    <head
        ><meta charset="utf-8" /><meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        /><meta
            name="description"
            content="Tu perfil TicketYa, tus compras y los planes que todavía tenés pendientes."
        /><title>Mi perfil — TicketYa</title><link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        /><link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        /><link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        /></head
    >
    <body class="account-page"
        ><SiteHeader />
        <main class="wrap profile-main" id="profile-main" hidden>
            <div class="profile-breadcrumb">
                <a href="/">Inicio</a><span>/</span> Mi cuenta
            </div>
            <section class="profile-welcome">
                <span class="profile-avatar" data-initials aria-hidden="true"></span>
                <div>
                    <h1 data-full-name>Mi cuenta</h1>
                    <p data-profile-email></p>
                    <span class="identity-label" id="identity-label" hidden></span>
                    <span data-first-name hidden></span>
                </div><a href="/#explorar" class="button button-blue"
                    >Explorar eventos <ArrowUpRight size={17} /></a>
            </section>
            <div class="profile-grid">
                <aside class="profile-sidebar">
                    <div
                        class="profile-tabs"
                        role="tablist"
                        aria-label="Mi cuenta"
                        aria-orientation="vertical"
                    >
                        <button id="tab-recomendaciones" role="tab" aria-selected="false" aria-controls="panel-recomendaciones" data-tab="recomendaciones" tabindex="-1"><Ticket size={18}/> Para vos <ArrowRight size={15}/></button>
                        <button id="tab-preferencias" role="tab" aria-selected="false" aria-controls="panel-preferencias" data-tab="preferencias" tabindex="-1"><SlidersHorizontal size={18} aria-hidden="true"/> Preferencias</button>
                        <button
                            id="tab-datos"
                            role="tab"
                            aria-selected="true"
                            aria-controls="panel-datos"
                            data-tab="datos"
                            ><UserRound size={18} /> Mis datos <ArrowRight
                                size={15}
                            /></button
                        ><button
                            id="tab-compras"
                            role="tab"
                            aria-selected="false"
                            aria-controls="panel-compras"
                            data-tab="compras"
                            tabindex="-1"
                            ><ShoppingBag size={18} /> Mis compras <span data-purchase-count>—</span
                            ></button
                        ><button
                            id="tab-entradas"
                            role="tab"
                            aria-selected="false"
                            aria-controls="panel-entradas"
                            data-tab="entradas"
                            tabindex="-1"
                            ><Ticket size={18} /> Mis entradas <span
                                data-entry-count>—</span
                            ></button
                        ><button
                            id="tab-carrito"
                            role="tab"
                            aria-selected="false"
                            aria-controls="panel-carrito"
                            data-tab="carrito"
                            tabindex="-1"
                            ><ShoppingCart size={18} /> Carrito <span
                                id="cart-count">0</span
                            ></button>
                        <button id="tab-notificaciones" role="tab" aria-selected="false" aria-controls="panel-notificaciones" data-tab="notificaciones" tabindex="-1"><Bell size={18} aria-hidden="true"/> Notificaciones</button>
                    </div>
                </aside>
                <div class="profile-panels">
                    <section id="panel-notificaciones" role="tabpanel" aria-labelledby="tab-notificaciones" data-panel="notificaciones" hidden>
                        <div class="profile-panel-heading"><h2>Notificaciones</h2></div>
                        <div class="profile-inbox" data-inbox>
                            <div class="history-filters" role="group" aria-label="Filtrar notificaciones">
                                <button type="button" aria-pressed="true" data-inbox-filter="all">Todas</button>
                                <button type="button" aria-pressed="false" data-inbox-filter="unread">Sin leer</button>
                                <button type="button" aria-pressed="false" data-inbox-filter="read">Leídas</button>
                            </div>
                            <div class="inbox-actions"><button class="text-link inbox-read-all" type="button" disabled>Marcar todas como leídas</button><button class="text-link inbox-retry" type="button" hidden>Reintentar</button></div>
                            <p class="inbox-status" role="status"></p>
                            <ol class="inbox-items"></ol>
                        </div>
                    </section>
                    <section id="panel-recomendaciones" role="tabpanel" aria-labelledby="tab-recomendaciones" data-panel="recomendaciones" hidden>
                        <div class="profile-panel-heading account-panel-heading">
                            <h2>Recomendados para vos</h2>
                            <a id="personalize-recommendations" class="button button-blue" href="#preferencias"><SlidersHorizontal size={17} aria-hidden="true"/> Personalizar recomendaciones</a>
                        </div>
                        <div class="sample-note"><Info size={17}/><p>Revisá la disponibilidad en el detalle del evento antes de comprar.</p></div>
                        <button id="reload-recommendations" class="text-link">Actualizar recomendaciones</button>
                        <p id="recommendation-status" role="status" aria-live="polite"></p>
                        <ul id="recommendation-warnings" role="status" aria-live="polite"></ul>
                        <p id="recommendation-verifications"></p><div id="recommendation-list"></div>
                    </section>
                    <section
                        id="panel-datos"
                        role="tabpanel"
                        aria-labelledby="tab-datos"
                        data-panel="datos"
                    >
                        <div class="profile-panel-heading">
                            <span class="eyebrow">A TU MANERA</span><h2>
                                Un poquito sobre vos.
                            </h2><p>
                                Mantené tus datos al día para tu próximo gran
                                momento.
                            </p>
                        </div><div
                            id="profile-error"
                            class="profile-alert"
                            role="alert"
                            tabindex="-1"
                            hidden
                        >
                            <Info size={17} /><span id="profile-error-text"
                            ></span><button id="retry-profile" type="button"
                                >Reintentar</button>
                        </div><form id="profile-form" novalidate>
                            <fieldset id="profile-fields" disabled>
                                <div class="profile-field">
                                    <label for="nombre">Nombre completo</label
                                    ><div>
                                        <UserRound size={17} /><input
                                            id="nombre" aria-describedby="nombre-error"
                                            autocomplete="name"
                                            maxlength="100"
                                            required
                                        /><span id="nombre-error" class="profile-field-error" aria-live="polite"></span>
                                    </div>
                                </div><div class="profile-field">
                                    <label for="email">Email</label><div>
                                        <Mail size={17} /><input
                                            id="email" aria-describedby="email-error"
                                            type="email"
                                            autocomplete="email"
                                            maxlength="254"
                                            required
                                        /><span id="email-error" class="profile-field-error" aria-live="polite"></span>
                                    </div>
                                </div><div class="profile-fields-row">
                                    <div class="profile-field">
                                        <label for="dni">DNI</label><div>
                                            <IdCard size={17} /><input
                                                id="dni" aria-describedby="dni-error"
                                                maxlength="20"
                                                required
                                            /><span id="dni-error" class="profile-field-error" aria-live="polite"></span>
                                        </div>
                                    </div><div class="profile-field">
                                        <label for="ciudad">Ciudad</label><div>
                                            <MapPin size={17} /><input
                                                id="ciudad" aria-describedby="ciudad-error"
                                                autocomplete="address-level2"
                                                maxlength="100"
                                                required
                                            /><span id="ciudad-error" class="profile-field-error" aria-live="polite"></span>
                                        </div>
                                    </div>
                                </div><div class="profile-form-foot">
                                    <span>Tu próximo plan empieza por vos.</span
                                    ><button
                                        class="button button-blue"
                                        id="save-profile"
                                        ><span id="save-profile-label">Guardar cambios</span> <Check
                                            size={17}
                                        /></button>
                                </div>
                            </fieldset><p
                                id="profile-status"
                                role="status"
                                aria-live="polite"
                            >
                            </p>
                        </form>
                    <section class="account-security" aria-labelledby="security-heading"><h2 id="security-heading">Seguridad de la sesión</h2><p>Cerrá sesión al terminar si usás un dispositivo compartido.</p><button type="button" class="button button-blue" data-logout><LogOut size={17} aria-hidden="true"/> Cerrar sesión</button></section>
                    </section>
                    <section id="panel-preferencias" role="tabpanel" aria-labelledby="tab-preferencias" data-panel="preferencias" hidden>
                        <div class="profile-panel-heading"><h2 id="preferences-heading" tabindex="-1">Tus preferencias</h2><p>Elegí qué tipos de eventos, ciudades y artistas querés ver en tus recomendaciones.</p></div>
                        <form id="preferences-form" class="account-preference-card">
                            <fieldset id="preferences-fields" disabled>
                                <legend>Eventos y ciudad</legend>
                                <p>Marcá los tipos de eventos que te interesan.</p>
                                <div id="preferred-types" class="history-filters" role="group" aria-label="Tipos de eventos preferidos"></div>
                                <div class="profile-field"><label for="preferred-city">Ciudad preferida (opcional)</label><div><input id="preferred-city" maxlength="100" autocomplete="off"/></div></div>
                                <button class="button button-blue" type="submit">Guardar preferencias</button>
                            </fieldset>
                            <p id="preferences-status" role="status" aria-live="polite"></p>
                            <button id="reload-preferences" type="button" class="text-link">Recargar preferencias guardadas</button>
                        </form>
                        <section aria-labelledby="artists-heading" class="account-preference-card">
                            <h3 id="artists-heading">Artistas favoritos</h3>
                            <label for="artist-choice">Artista del catálogo</label>
                            <select id="artist-choice" disabled><option value="">Cargando catálogo…</option></select>
                            <button id="add-artist" type="button" class="text-link" disabled>Agregar a favoritos</button>
                            <ul id="favorite-artists"></ul>
                            <p id="artists-status" role="status" aria-live="polite"></p>
                            <button id="reload-artists" type="button" class="text-link">Actualizar artistas</button>
                        </section>
                    </section>
                    <section
                        id="panel-compras"
                        role="tabpanel"
                        aria-labelledby="tab-compras"
                        data-panel="compras"
                        hidden
                    >
                        <div class="profile-panel-heading">
                            <span class="eyebrow"
                                >MOMENTOS QUE YA SON TUYOS</span
                            ><h2>Compras y devoluciones</h2><p>
                                Un recorrido por tus entradas y compras.
                            </p>
                        </div><div class="sample-note">
                            <Info size={16} /><p>
                                Tus compras, pagos y reintegros simulados.
                            </p></div>
                        <div class="history-filters" role="group" aria-label="Filtrar compras por estado">
                        <button data-history-filter="" aria-pressed="true">Todas <span data-purchase-count>—</span></button>
                        <button data-history-filter="PENDIENTE" aria-pressed="false">Pendientes</button>
                        <button data-history-filter="APROBADA" aria-pressed="false">Aprobadas</button>
                        <button data-history-filter="RECHAZADA" aria-pressed="false">Rechazadas</button>
                        <button data-history-filter="EXPIRADA" aria-pressed="false">Expiradas</button>
                        <button data-history-filter="CANCELADA" aria-pressed="false">Canceladas</button></div>
                        <button id="refresh-history" class="text-link">Actualizar historial</button><p id="history-status" role="status" aria-live="polite"></p><div id="purchase-list"></div>
                        <section class="account-refunds" aria-labelledby="refunds-heading"><div><h3 id="refunds-heading">Mis solicitudes de devolución</h3><button id="refresh-refunds" class="text-link">Consultar solicitudes y entradas</button><p id="refunds-status" role="status" aria-live="polite"></p><ul id="refund-list"></ul><p>Estados PENDIENTE, ACEPTADA y RECHAZADA según el servidor. Los reintegros son simulados. Tras un rechazo, el backend no admite usar el QR para ingreso.</p></div></section>
                    </section>
                    <section
                        id="panel-entradas"
                        role="tabpanel"
                        aria-labelledby="tab-entradas"
                        data-panel="entradas"
                        hidden
                    >
                        <div class="profile-panel-heading">
                            <span class="eyebrow"
                                >LISTAS PARA TU PRÓXIMO MOMENTO</span
                            ><h2>Mis entradas</h2><p>
                                Tus entradas, una por cada lugar que elegiste.
                            </p>
                        </div>
                        <div class="sample-note">
                            <Info size={16} /><p>
                                Entradas consultadas al servidor. El QR conserva la cadena original; verlo no registra ingreso ni garantiza acceso.
                            </p></div><button id="refresh-tickets" class="text-link">Actualizar entradas</button>
                        <div class="ticket-stats">
                            <div>
                                <strong id="valid-tickets">0</strong><span
                                    >Pagas sin escanear</span>
                            </div><div>
                                <strong id="pending-tickets">0</strong><span
                                    >Devoluciones pendientes</span>
                            </div><div>
                                <strong id="other-tickets">0</strong><span
                                    >Escaneadas</span>
                            </div>
                        </div>
                        <div class="history-filters" role="group" aria-label="Filtrar por fecha del evento">
                            <button type="button" data-ticket-period="" aria-pressed="true">Todas las fechas</button>
                            <button type="button" data-ticket-period="upcoming" aria-pressed="false">Próximos eventos</button>
                            <button type="button" data-ticket-period="past" aria-pressed="false">Eventos pasados</button>
                        </div>
                        <div class="history-filters ticket-filters" role="group" aria-label="Filtrar entradas">
                        <button data-ticket-filter="" aria-pressed="true">Todas</button><button data-ticket-filter="PAGA" aria-pressed="false">Pagas</button><button data-ticket-filter="SOLICITUD_DEVOLUCION" aria-pressed="false">Devolución pendiente</button><button data-ticket-filter="DEVOLUCION_ACEPTADA" aria-pressed="false">Devolución aceptada</button><button data-ticket-filter="DEVOLUCION_RECHAZADA" aria-pressed="false">Devolución rechazada</button><button data-ticket-filter="EVENTO_CANCELADO" aria-pressed="false">Evento cancelado</button><button data-ticket-filter="scan:ESCANEADO" aria-pressed="false">Escaneadas</button><button data-ticket-filter="scan:NO_ESCANEADO" aria-pressed="false">Sin escanear</button></div>
                        <div
                            class="purchase-ticket-filter"
                            id="purchase-ticket-filter"
                            hidden
                        >
                            <span id="purchase-ticket-label"></span><button
                                id="clear-purchase-ticket"
                                >Ver todas mis entradas <X size={13} /></button>
                        </div>
                        <div id="ticket-list"></div><div
                            id="tickets-empty"
                            class="profile-empty"
                            hidden
                        >
                            <Ticket size={32} /><h3>
                                No hay entradas en esta sección.
                            </h3><p>
                                Probá con otro filtro o elegí tu próximo evento.
                            </p><a class="button button-blue" href="/#explorar">Explorar próximos eventos</a>
                        </div>
                        <p
                            id="tickets-status"
                            role="status"
                            aria-live="polite"
                        >
                        </p>
                    </section>

                    <section
                        id="panel-carrito"
                        role="tabpanel"
                        aria-labelledby="tab-carrito"
                        data-panel="carrito"
                        hidden
                    >
                        <div class="profile-panel-heading">
                            <span class="eyebrow"
                                >TODAVÍA ESTÁS A TIEMPO DE ELEGIR</span
                            ><h2>Mi carrito</h2><p>
                                Los eventos que guardaste para seguir eligiendo
                                después.
                            </p>
                        </div><div class="sample-note">
                            <Info size={16} /><p>
                                Las selecciones se guardan en este navegador. <strong
                                    >No reservan lugares ni garantizan
                                    disponibilidad.</strong>
                            </p>
                        </div><button id="refresh-cart" class="text-link">Revalidar carrito</button><div id="cart-list"></div><div
                            id="cart-empty"
                            class="profile-empty"
                            hidden
                        >
                            <ShoppingCart size={35} /><h3>
                                Tu próximo plan está por llegar.
                            </h3><p>
                                Elegí un evento y guardá tus entradas en el
                                carrito.
                            </p><a href="/#explorar" class="button button-blue"
                                >Explorar eventos <ArrowRight size={17} /></a>
                        </div><div
                            class="cart-total"
                            id="cart-total-box"
                            hidden
                        >
                            <div>
                                <span>Total de tus selecciones</span><strong
                                    id="cart-total"></strong>
                            </div><p>
                                Cada selección se verifica por separado. Guardar no reserva lugares.
                            </p>
                        </div><p
                            id="cart-status"
                            role="status"
                            aria-live="polite"
                        >
                        </p>
                    </section>
                </div>
            </div>
            
        </main>
        <noscript
            ><p class="wrap">
                Activá JavaScript para consultar tu perfil.
            </p></noscript
        >
        <SiteFooter />
        <dialog id="purchase-dialog" aria-labelledby="purchase-title">
            <div class="dialog-head">
                <span class="eyebrow">DETALLE DE COMPRA</span><button
                    class="icon-button"
                    data-close-purchase
                    aria-label="Cerrar detalle"><X size={22} /></button>
            </div><div class="dialog-body">
                <a id="history-resume-detail" class="text-link" hidden>Revisar compra pendiente</a><button id="history-entry-detail" class="text-link" data-purchase-tickets>Ver entradas de esta compra</button><h2 id="purchase-title"></h2><p id="purchase-detail"></p><p
                    id="purchase-payment"
                >
                </p><div class="purchase-modal-total">
                    <span>Importe del servidor</span><strong id="purchase-total"
                    ></strong>
                </div><p class="demo-note">
                    Datos de la compra recibidos del servidor. El pago y los reintegros son simulados.
                </p><button class="button button-blue" data-close-purchase
                    >Volver a mis compras <ArrowRight size={17} /></button>
            </div>
        </dialog>
        <dialog id="ticket-qr-dialog" aria-labelledby="qr-title">
            <div class="dialog-head">
                <span class="eyebrow">TU ENTRADA</span><button
                    class="icon-button"
                    data-close-qr
                    aria-label="Cerrar QR"><X size={22} /></button>
            </div><div class="dialog-body ticket-qr-body">
                <span class="qr-demo-badge">PRESENTÁ ESTE QR EN PUERTA</span
                ><h2 id="qr-title"></h2><p id="qr-location"></p><p id="qr-date">
                </p><div class="qr-frame">
                    <img
                        id="ticket-qr-image"
                        alt="Código QR de la entrada recibido del servidor"
                        hidden
                    /><p id="qr-loading" role="status">Preparando el QR…</p>
                </div><strong id="qr-ticket-id" class="qr-ticket-id"></strong><p
                    class="demo-note"
                >
                    El QR representa la cadena exacta del servidor. Mostrarlo no consume la entrada. El personal de ingreso verifica su estado.
                </p><button class="button button-blue" data-close-qr
                    >Volver a mis entradas <ArrowRight size={17} /></button>
            </div>
        </dialog>
        <dialog id="ticket-refund-dialog" aria-labelledby="refund-title"><div class="dialog-head"><span class="eyebrow">SOLICITUD DE DEVOLUCIÓN</span><button class="icon-button" data-close-refund aria-label="Cerrar solicitud"><X size={22}/></button></div><div class="dialog-body"><h2 id="refund-title">Solicitar devolución</h2><p>Podés solicitar hasta 72 horas antes del inicio del evento, una entrada por solicitud. El servidor determina la elegibilidad. Enviar no implica aceptación ni reintegro.</p><p id="refund-message" role="status" aria-live="polite"></p><form id="refund-form"><label for="refund-description">Motivo</label><textarea id="refund-description" required rows="4"></textarea><button id="confirm-refund" class="button button-blue" type="submit" disabled>Enviar solicitud</button><button class="text-link" data-close-refund type="button">Volver sin enviar</button></form></div></dialog>
        <script>
            import "../scripts/profile";
        </script>
    </body>
</html>

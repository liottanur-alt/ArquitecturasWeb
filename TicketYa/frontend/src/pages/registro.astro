---import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

import "../styles/global.css";
import "../styles/login.css";
import "../styles/register.css";
import {
  Ticket,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  CircleAlert,
} from "@lucide/astro";
---

<!doctype html>
<html lang="es-AR">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta
      name="description"
      content="Creá tu cuenta de TicketYa."
    /><meta name="theme-color" content="#2055f5" /><title>
      Crear cuenta — TicketYa
    </title><link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    /></head
  >
  <body class="login-page register-page">
    <SiteHeader />
    <main class="login-layout">
      <section class="login-story" aria-label="Hay que estar ahí">
        <img
          src="https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?auto=format&fit=crop&w=1400&q=85"
          alt=""
        /><div class="story-shade"></div><div class="story-content">
          <span class="eyebrow"
            ><span class="live-dot"></span> EN VIVO SE SIENTE DISTINTO</span
          ><h1>
            Hay momentos<br />que empiezan<br />con un <span>sí.</span>
          </h1><p>
            A esa canción. A ese plan con amigos.<br />A estar justo donde
            querés estar.
          </p><div class="story-ticket">
            <span class="ticket-cut"></span><div class="mini-ticket-icon">
              <Ticket size={28} />
            </div><div>
              <strong>Tu próximo “yo estuve ahí”.</strong><span
                >Un buen plan te está esperando.</span>
            </div><ArrowUpRight size={24} />
          </div>
        </div><span class="story-footer"
          >MENOS PANTALLA. MÁS HISTORIAS PARA CONTAR.</span>
      </section>
      <section class="login-form-side" aria-labelledby="login-title">
        <a href="/" class="login-back"
          ><ArrowLeft size={16} /> Volver a explorar</a
        >
        <div class="login-form-content">
          <h2 id="login-title">Creá tu cuenta</h2>
          <form id="register-form" method="post" aria-labelledby="login-title" novalidate>
            <fieldset id="register-fields"><div class="login-field"><label for="nombre">Nombre completo</label><div class="login-input"><input id="nombre" name="nombre" type="text"  autocomplete="name" maxlength="100" required aria-describedby="nombre-error" /></div><span id="nombre-error" class="field-help" aria-live="polite"></span></div>
<div class="login-field"><label for="email">Email</label><div class="login-input"><input id="email" name="email" type="text" inputmode="email" autocomplete="email" maxlength="254" required aria-describedby="email-error" /></div><span id="email-error" class="field-help" aria-live="polite"></span></div>
<div class="login-field"><label for="dni">DNI</label><div class="login-input"><input id="dni" name="dni" type="text"  autocomplete="off" maxlength="20" required aria-describedby="dni-error" /></div><span id="dni-error" class="field-help" aria-live="polite"></span></div>
<div class="login-field"><label for="ciudad">Ciudad</label><div class="login-input"><input id="ciudad" name="ciudad" type="text"  autocomplete="address-level2" maxlength="100" required aria-describedby="ciudad-error" /></div><span id="ciudad-error" class="field-help" aria-live="polite"></span></div>

            <div class="login-field"><label for="password">Contraseña</label><div class="login-input"><input id="password" name="password" type="password" autocomplete="new-password" minlength="4" required aria-describedby="password-error" /></div><span id="password-error" class="field-help" aria-live="polite"></span></div>
            <button id="register-submit" class="button button-blue login-submit" type="submit"><span id="register-submit-label">Crear cuenta</span><ArrowRight size={19}/><span class="submit-spinner" aria-hidden="true"></span></button></fieldset>
            <div id="register-error" class="login-error" role="alert" tabindex="-1" hidden><CircleAlert size={18}/><p id="register-error-text"></p></div>
            <p id="register-status" class="login-subtitle" role="status" aria-live="polite"></p>


          </form>
          <p class="auth-switch">¿Ya tenés cuenta? <a id="select-profile-link" href="/login/">Iniciar sesión <ArrowUpRight size={14}/></a></p>
        </div>
      </section>
    </main>
    <SiteFooter />
    <script>
      import "../scripts/register";
    </script>
  </body>
</html>

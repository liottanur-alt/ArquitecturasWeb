---
import { ChevronDown, LogOut } from '@lucide/astro';
import NotificationInbox from './NotificationInbox.astro';
---
<div class="shell-account">
  <NotificationInbox />
  <div class="shell-auth" data-shell-guest>
    <a class="shell-link" href="/login/" data-shell-login>Iniciar sesión</a>
    <a class="shell-primary" href="/registro/" data-shell-register>Registrarse</a>
  </div>
  <details class="shell-account-menu" data-shell-account hidden>
    <summary aria-label="Menú de cuenta">
      <span class="shell-avatar" data-shell-initials aria-hidden="true">?</span>
      <span class="shell-account-name" data-shell-name>Mi cuenta</span>
      <ChevronDown size={15} aria-hidden="true" />
    </summary>
    <div class="shell-popover">
      <nav aria-label="Mi cuenta">
        <a href="/perfil/">Mi perfil</a>
        <a href="/perfil/#entradas">Mis entradas</a>
        <a href="/perfil/#compras">Historial de compras</a>
        <a href="/perfil/#recomendaciones">Para vos</a>
        <a href="/perfil/#carrito">Mi carrito</a>
      </nav>
      <button type="button" data-shell-logout><LogOut size={16} aria-hidden="true" /> Cerrar sesión</button>
    </div>
  </details>
</div>

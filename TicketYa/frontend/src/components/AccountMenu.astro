---
import { ArrowUpRight, LogOut, UserRound } from '@lucide/astro';
---
<div class="account-widget">
  <a href="/login/" class="login-button" data-login-link>Ingresar <ArrowUpRight size={16}/></a>
  <details data-account-menu hidden><summary class="login-button"><UserRound size={16}/> Mi cuenta</summary><div class="account-popover"><span>SESIÓN INICIADA</span><p data-account-email></p><nav class="account-links" aria-label="Mi cuenta"><a href="/perfil/">Mi perfil</a><a href="/perfil/#compras">Mis compras</a><a href="/perfil/#carrito">Mi carrito</a></nav><button data-logout><LogOut size={15}/> Cerrar sesión</button></div></details>
</div>
<style>
  .account-widget{position:relative}summary{cursor:pointer;list-style:none}summary::-webkit-details-marker{display:none}.account-popover{position:absolute;right:0;top:calc(100% + 12px);width:250px;border:1px solid #e6e8ee;border-radius:12px;padding:20px;background:white;box-shadow:0 12px 40px #17203916;z-index:20}.account-popover>span{font-size:8px;letter-spacing:1.5px;color:#8a93a5;font-weight:650}.account-popover p{font-size:12px;color:#52607a;overflow-wrap:anywhere;margin-top:10px}.account-popover button{width:100%;display:flex;align-items:center;gap:9px;padding:14px 0 0;margin-top:15px;border-top:1px solid #eef0f5;background:transparent;font-size:12px;color:#2055f5}
.account-links{display:flex;flex-direction:column;gap:11px;padding-top:17px;margin-top:14px;border-top:1px solid #eef0f5}.account-links a{font-size:12px;color:#71819b}.account-links a:hover{color:#2055f5}
</style>
<script>
  import {getSession,clearSession} from '../scripts/session';
  let expiryTimer:ReturnType<typeof setTimeout>;
  function refresh(){
    clearTimeout(expiryTimer);const session=getSession();
    document.querySelectorAll<HTMLElement>('[data-login-link]').forEach(link=>{link.hidden=!!session;});
    document.querySelectorAll<HTMLDetailsElement>('[data-account-menu]').forEach(menu=>{menu.hidden=!session;if(!session)menu.open=false;});
    document.querySelectorAll('[data-account-email]').forEach(el=>{el.textContent=session?.email||'';});
    if(session)expiryTimer=setTimeout(refresh,Math.min(session.expiresAt-Date.now()+50,2147483647));
  }
  document.querySelectorAll('[data-logout]').forEach(button=>button.addEventListener('click',()=>{clearSession();refresh();window.dispatchEvent(new Event('ticketya:session'));}));
  document.addEventListener('click',e=>document.querySelectorAll<HTMLDetailsElement>('[data-account-menu]').forEach(menu=>{if(!menu.contains(e.target as Node))menu.open=false;}));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll<HTMLDetailsElement>('[data-account-menu]').forEach(menu=>menu.open=false);});
  window.addEventListener('ticketya:session',refresh);window.addEventListener('pageshow',refresh);document.addEventListener('visibilitychange',refresh);refresh();
</script>

---
import { ArrowUpRight, LogOut, UserRound } from "@lucide/astro";
---

<div class="account-widget">
  <a href="/login/" class="login-button" data-login-link
    >Elegir perfil <ArrowUpRight size={16} /></a
  >
  <details data-account-menu hidden>
    <summary class="login-button"><UserRound size={16} /> Mi cuenta</summary
    ><div class="account-popover">
      <span>PERFIL DE DEMOSTRACIÓN</span><p data-account-email></p><p>Seleccionar un perfil no autentica al usuario.</p><nav
        class="account-links"
        aria-label="Mi cuenta"
      >
        <a href="/perfil/">Mi perfil</a><a href="/perfil/#recomendaciones">Recomendaciones</a><a href="/perfil/#compras"
          >Mis compras</a
        ><a href="/perfil/#entradas">Mis entradas</a><a href="/perfil/#carrito"
          >Mi carrito</a>
      <a data-change-profile href="/login/?volver=/perfil/">Cambiar perfil</a></nav><button data-logout><LogOut size={15} /> Quitar perfil</button>
    </div>
  </details>
</div>
<style>
  .account-widget {
    position: relative;
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .account-popover {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    width: 250px;
    border: 1px solid #e6e8ee;
    border-radius: 12px;
    padding: 20px;
    background: white;
    box-shadow: 0 12px 40px #17203916;
    z-index: 20;
  }
  .account-popover > span {
    font-size: 8px;
    letter-spacing: 1.5px;
    color: #8a93a5;
    font-weight: 650;
  }
  .account-popover p {
    font-size: 12px;
    color: #52607a;
    overflow-wrap: anywhere;
    margin-top: 10px;
  }
  .account-popover button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 0 0;
    margin-top: 15px;
    border-top: 1px solid #eef0f5;
    background: transparent;
    font-size: 12px;
    color: #2055f5;
  }
  .account-links {
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding-top: 17px;
    margin-top: 14px;
    border-top: 1px solid #eef0f5;
  }
  .account-links a {
    font-size: 12px;
    color: #71819b;
  }
  .account-links a:hover {
    color: #2055f5;
  }
</style>
<script>
  import { getSelectedProfileId, clearSelectedProfile } from "../scripts/session";
  function refresh() {
    const session = getSelectedProfileId();
    document.querySelectorAll<HTMLAnchorElement>("[data-change-profile], [data-login-link]").forEach(link => { link.href = "/login/?volver=" + encodeURIComponent(location.pathname + location.search + location.hash); });
    document
      .querySelectorAll<HTMLElement>("[data-login-link]")
      .forEach((link) => {
        link.hidden = !!session;
      });
    document
      .querySelectorAll<HTMLDetailsElement>("[data-account-menu]")
      .forEach((menu) => {
        menu.hidden = !session;
        if (!session) menu.open = false;
      });
    document.querySelectorAll("[data-account-email]").forEach((el) => {
      el.textContent = session ? `Perfil #${session}` : "";
    });

  }
  document.querySelectorAll("[data-logout]").forEach((button) =>
    button.addEventListener("click", () => {
      try { clearSelectedProfile(); } catch { window.alert("No pudimos quitar el perfil. Revisá el almacenamiento de esta pestaña."); }
      refresh();
    }),
  );
  document.addEventListener("click", (e) =>
    document
      .querySelectorAll<HTMLDetailsElement>("[data-account-menu]")
      .forEach((menu) => {
        if (!menu.contains(e.target as Node)) menu.open = false;
      }),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape")
      document
        .querySelectorAll<HTMLDetailsElement>("[data-account-menu]")
        .forEach((menu) => (menu.open = false));
  });
  window.addEventListener("ticketya:profile", refresh);
  window.addEventListener("pageshow", refresh);
  document.addEventListener("visibilitychange", refresh);
  refresh();
</script>

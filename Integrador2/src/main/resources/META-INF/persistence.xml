<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
			 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
			 version="3.0">

	<persistence-unit name="Integrador_2">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<!-- Clases Entidades Mapeadas -->
		<class>main.java.Entities.Estudiante</class>
		<class>main.java.Entities.Carrera</class>
		<class>main.java.Entities.EstudianteCarrera</class>

		<properties>
			<!-- Conexión a la Base de Datos MySQL (Docker Compose) -->
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/integrador1?createDatabaseIfNotExist=true&amp;useSSL=false&amp;allowPublicKeyRetrieval=true" />
			<property name="jakarta.persistence.jdbc.user" value="root" />
			<property name="jakarta.persistence.jdbc.password" value="password" />

			<!-- Dialecto MySQL para Hibernate -->
			<property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />

			<!-- Generación automática del esquema en la base de datos (update/create) -->
			<property name="hibernate.hbm2ddl.auto" value="update" />

			<!-- Mostrar consultas SQL en consola -->
			<property name="hibernate.show_sql" value="true" />
			<property name="hibernate.format_sql" value="true" />
		</properties>
	</persistence-unit>

</persistence>